<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MarkdownViewer-Setup</AssemblyName>
    <RootNamespace>MarkdownViewerInstaller</RootNamespace>
    <ApplicationIcon>..\MarkdownViewer\app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>MarkdownViewer Installer</Product>
    <FileVersion>1.1.0.0</FileVersion>
    <!-- 单文件自包含：用户机器无需安装 .NET 运行时；启用压缩减小体积 -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>

  <!-- payload.zip 不再内嵌：安装时从安装器同目录读取，
       让安装器单文件保持在 GitHub 100MB 限制以内 -->

</Project>
