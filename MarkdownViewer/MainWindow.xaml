<Window x:Class="MarkdownViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MarkdownViewer - Markdown 阅读与编辑器"
        Height="820" Width="1280"
        MinHeight="460" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MainBgBrush}"
        AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver">

    <Window.Resources>
        <!-- 浅色（默认） -->
        <SolidColorBrush x:Key="MainBgBrush" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="ToolbarBgBrush" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="TocPanelBgBrush" Color="#F6F8FA"/>
        <SolidColorBrush x:Key="TocTextBrush" Color="#24292F"/>
        <SolidColorBrush x:Key="TocSelectedBrush" Color="#CCE4FF"/>
        <SolidColorBrush x:Key="SplitterBrush" Color="#D0D7DE"/>
        <SolidColorBrush x:Key="StatusTextBrush" Color="#57606A"/>
        <SolidColorBrush x:Key="BorderBrush2" Color="#D0D7DE"/>

        <!-- ===== 菜单 / 右键菜单：自定义模板，保证暗色与护眼主题下背景与文字可读 ===== -->
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="6,4" Background="{DynamicResource BorderBrush2}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TocTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Check" Grid.Column="0" Text="✓"
                                               Margin="0,0,6,0" Visibility="Collapsed"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TocTextBrush}"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                               Margin="18,0,0,0" VerticalAlignment="Center"
                                               Opacity="0.65"
                                               Foreground="{DynamicResource TocTextBrush}"/>
                                    <TextBlock x:Name="Arrow" Grid.Column="3" Text="›"
                                               Margin="12,0,0,0" Visibility="Collapsed"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TocTextBrush}"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Right"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade" HorizontalOffset="-4" VerticalOffset="-4">
                                <Border Background="{DynamicResource TocPanelBgBrush}"
                                        BorderBrush="{DynamicResource BorderBrush2}"
                                        BorderThickness="1" CornerRadius="6" Padding="4"
                                        Margin="0,0,10,10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35"/>
                                    </Border.Effect>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                                <Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="0"/>
                                <Setter TargetName="PART_Popup" Property="VerticalOffset" Value="2"/>
                                <Setter Property="Padding" Value="12,6"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource TocSelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource TocSelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{DynamicResource TocTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource TocPanelBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="4"
                                Margin="0,0,10,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35"/>
                            </Border.Effect>
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Office 风格功能区：标签页 / 按钮 / 开关 / 分段按钮 ===== -->
        <Style x:Key="RibbonTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TocTextBrush}"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource TocSelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource TocSelectedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RibbonButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TocTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource TocSelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RibbonToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TocTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource TocSelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource TocSelectedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource BorderBrush2}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RibbonRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TocTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource TocSelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource TocSelectedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RibbonLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StatusTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,4,0"/>
        </Style>

        <Style x:Key="RibbonSeparator" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrush2}"/>
        </Style>
    </Window.Resources>

    <!-- 窗口级快捷键：Ctrl+S 保存、Ctrl+O 打开、F5 重新加载 -->
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="NewCommand_Executed"/>
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveCommand_Executed"/>
        <CommandBinding Command="ApplicationCommands.Open" Executed="OpenCommand_Executed"/>
        <CommandBinding Command="NavigationCommands.Refresh" Executed="ReloadCommand_Executed"/>
    </Window.CommandBindings>

    <DockPanel>
        <!-- Office 风格功能区：标签栏 + 当前标签对应的工具栏 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBgBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="6,3,6,0">
                <RadioButton x:Name="RibbonFileTab" Content="文件" Tag="file" GroupName="RibbonTabs"
                             IsChecked="True" Style="{StaticResource RibbonTab}" Checked="RibbonTab_Checked"/>
                <RadioButton x:Name="RibbonEditTab" Content="编辑" Tag="edit" GroupName="RibbonTabs"
                             Style="{StaticResource RibbonTab}" Checked="RibbonTab_Checked"/>
                <RadioButton x:Name="RibbonViewTab" Content="视图" Tag="view" GroupName="RibbonTabs"
                             Style="{StaticResource RibbonTab}" Checked="RibbonTab_Checked"/>
                <RadioButton x:Name="RibbonEncodingTab" Content="编码" Tag="encoding" GroupName="RibbonTabs"
                             Style="{StaticResource RibbonTab}" Checked="RibbonTab_Checked"/>
                <RadioButton x:Name="RibbonHelpTab" Content="帮助" Tag="help" GroupName="RibbonTabs"
                             Style="{StaticResource RibbonTab}" Checked="RibbonTab_Checked"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="{DynamicResource TocPanelBgBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1"
                Padding="6,4" MinHeight="40">
            <Grid>
                <!-- 文件 -->
                <WrapPanel x:Name="RibbonFilePanel" Orientation="Horizontal">
                    <Button Style="{StaticResource RibbonButton}" Content="新建"
                            Click="NewFile_Click" ToolTip="Ctrl+N"/>
                    <Button Style="{StaticResource RibbonButton}" Content="打开..."
                            Click="OpenFile_Click" ToolTip="Ctrl+O"/>
                    <Menu Background="Transparent" BorderThickness="0" Padding="0"
                          VerticalAlignment="Center" Foreground="{DynamicResource TocTextBrush}">
                        <MenuItem x:Name="RecentMenu" Header="最近打开 ▾" Padding="10,5"/>
                    </Menu>
                    <Button Style="{StaticResource RibbonButton}" Content="文件夹搜索"
                            Click="SearchInFolder_Click" ToolTip="Ctrl+Shift+F"/>
                    <Border Style="{StaticResource RibbonSeparator}"/>
                    <Button Style="{StaticResource RibbonButton}" Content="保存"
                            Click="Save_Click" ToolTip="Ctrl+S"/>
                    <Button Style="{StaticResource RibbonButton}" Content="另存为..."
                            Click="SaveAs_Click" ToolTip="Ctrl+Shift+S"/>
                    <Button Style="{StaticResource RibbonButton}" Content="重新加载"
                            Click="Reload_Click" ToolTip="F5"/>
                    <Border Style="{StaticResource RibbonSeparator}"/>
                    <Button Style="{StaticResource RibbonButton}" Content="导出 HTML"
                            Click="ExportHtml_Click"/>
                    <Button Style="{StaticResource RibbonButton}" Content="导出 PDF"
                            Click="ExportPdf_Click"/>
                    <Button Style="{StaticResource RibbonButton}" Content="打印"
                            Click="Print_Click" ToolTip="Ctrl+P"/>
                    <Border Style="{StaticResource RibbonSeparator}"/>
                    <Button Style="{StaticResource RibbonButton}" Content="关闭标签"
                            Click="CloseCurrentTab_Click" ToolTip="Ctrl+W"/>
                    <Button Style="{StaticResource RibbonButton}" Content="退出"
                            Click="Exit_Click"/>
                </WrapPanel>

                <!-- 编辑 -->
                <WrapPanel x:Name="RibbonEditPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Style="{StaticResource RibbonButton}" Content="查找 / 替换"
                            Click="Find_Click" ToolTip="Ctrl+F"/>
                    <Button Style="{StaticResource RibbonButton}" Content="查找下一个"
                            Click="FindNext_Click" ToolTip="F3"/>
                    <Border Style="{StaticResource RibbonSeparator}"/>
                    <Button Style="{StaticResource RibbonButton}" Content="插入图片..."
                            Click="InsertImage_Click"/>
                    <Button Style="{StaticResource RibbonButton}" Content="插入表格"
                            Click="InsertTable_Click"/>
                    <Button Style="{StaticResource RibbonButton}" Content="插入流程图"
                            Click="InsertMermaid_Click"
                            ToolTip="打开 Mermaid 编辑器，双击已有图表也可编辑"/>
                    <Button Style="{StaticResource RibbonButton}" Content="插入代码块"
                            Click="InsertCodeBlock_Click"/>
                    <Button Style="{StaticResource RibbonButton}" Content="插入任务列表"
                            Click="InsertTaskList_Click"/>
                </WrapPanel>

                <!-- 视图 -->
                <WrapPanel x:Name="RibbonViewPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="视图：" Style="{StaticResource RibbonLabel}"/>
                    <RadioButton x:Name="ViewPreview" Content="预览" GroupName="ViewGroup"
                                 IsChecked="True" Style="{StaticResource RibbonRadio}"
                                 Checked="View_Changed"/>
                    <RadioButton x:Name="ViewSplit" Content="分栏" GroupName="ViewGroup"
                                 Style="{StaticResource RibbonRadio}" Checked="View_Changed"/>
                    <RadioButton x:Name="ViewEdit" Content="编辑" GroupName="ViewGroup"
                                 Style="{StaticResource RibbonRadio}" Checked="View_Changed"/>
                    <Border Style="{StaticResource RibbonSeparator}"/>
                    <ToggleButton x:Name="TocToggle" Content="隐藏目录" IsChecked="True"
                                  Style="{StaticResource RibbonToggle}"
                                  Checked="TocToggle_Changed" Unchecked="TocToggle_Changed"/>
                    <ToggleButton x:Name="TypewriterToggle" Content="打字机模式"
                                  Style="{StaticResource RibbonToggle}"
                                  Click="TypewriterToggle_Click"/>
                    <ToggleButton x:Name="AutoSaveToggle" Content="自动保存"
                                  Style="{StaticResource RibbonToggle}"
                                  Click="AutoSaveToggle_Click"
                                  ToolTip="定时保存有未保存修改的文件"/>
                    <Border Style="{StaticResource RibbonSeparator}"/>
                    <Button Style="{StaticResource RibbonButton}" Content="放大"
                            Click="ZoomIn_Click" ToolTip="Ctrl+="/>
                    <Button Style="{StaticResource RibbonButton}" Content="缩小"
                            Click="ZoomOut_Click" ToolTip="Ctrl+-"/>
                    <Button Style="{StaticResource RibbonButton}" Content="重置"
                            Click="ZoomReset_Click" ToolTip="Ctrl+0"/>
                    <Button Style="{StaticResource RibbonButton}" Content="全屏"
                            Click="FullScreen_Click" ToolTip="F11"/>
                    <Border Style="{StaticResource RibbonSeparator}"/>
                    <TextBlock Text="显示模式：" Style="{StaticResource RibbonLabel}"/>
                    <RadioButton x:Name="ThemeLightRadio" Content="浅色" Tag="light"
                                 GroupName="ThemeGroup" Style="{StaticResource RibbonRadio}"
                                 Checked="ThemeRadio_Checked"/>
                    <RadioButton x:Name="ThemeGreenRadio" Content="护眼绿" Tag="green"
                                 GroupName="ThemeGroup" Style="{StaticResource RibbonRadio}"
                                 Checked="ThemeRadio_Checked"/>
                    <RadioButton x:Name="ThemeDarkRadio" Content="暗黑" Tag="dark"
                                 GroupName="ThemeGroup" Style="{StaticResource RibbonRadio}"
                                 Checked="ThemeRadio_Checked"/>
                    <RadioButton x:Name="ThemeSystemRadio" Content="跟随系统" Tag="system"
                                 GroupName="ThemeGroup" Style="{StaticResource RibbonRadio}"
                                 Checked="ThemeRadio_Checked"/>
                </WrapPanel>

                <!-- 编码 -->
                <WrapPanel x:Name="RibbonEncodingPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Style="{StaticResource RibbonButton}" Content="UTF-8"
                            Tag="Utf8NoBom" Click="EncodingMenu_Click"/>
                    <Button Style="{StaticResource RibbonButton}" Content="UTF-8 (BOM)"
                            Tag="Utf8Bom" Click="EncodingMenu_Click"/>
                    <Button Style="{StaticResource RibbonButton}" Content="UTF-16 LE"
                            Tag="Utf16LE" Click="EncodingMenu_Click"/>
                    <Button Style="{StaticResource RibbonButton}" Content="UTF-16 BE"
                            Tag="Utf16BE" Click="EncodingMenu_Click"/>
                    <Button Style="{StaticResource RibbonButton}" Content="GB18030"
                            Tag="Gb18030" Click="EncodingMenu_Click"/>
                    <Button Style="{StaticResource RibbonButton}" Content="Big5"
                            Tag="Big5" Click="EncodingMenu_Click"/>
                    <Button Style="{StaticResource RibbonButton}" Content="Shift-JIS"
                            Tag="ShiftJis" Click="EncodingMenu_Click"/>
                    <Button Style="{StaticResource RibbonButton}" Content="EUC-KR"
                            Tag="EucKr" Click="EncodingMenu_Click"/>
                    <Button Style="{StaticResource RibbonButton}" Content="Windows-1252"
                            Tag="Windows1252" Click="EncodingMenu_Click"/>
                    <Border Style="{StaticResource RibbonSeparator}"/>
                    <Button Style="{StaticResource RibbonButton}" Content="按当前编码重新读取"
                            Click="ReloadWithEncoding_Click"/>
                </WrapPanel>

                <!-- 帮助 -->
                <WrapPanel x:Name="RibbonHelpPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Style="{StaticResource RibbonButton}" Content="快捷键"
                            Click="Shortcuts_Click"/>
                    <Button Style="{StaticResource RibbonButton}" Content="打开日志目录"
                            Click="OpenLogDir_Click"/>
                    <Button Style="{StaticResource RibbonButton}" Content="关于 MarkdownViewer"
                            Click="About_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 多标签页：每个标签对应一个打开的 md 文档；彩色圆角，支持双击弹出独立窗口 -->
        <Grid DockPanel.Dock="Top">
            <TabControl x:Name="Tabs" Height="38" Padding="4,0,0,0"
                        BorderThickness="0,0,0,1"
                        Background="{DynamicResource ToolbarBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush2}"
                        Foreground="{DynamicResource TocTextBrush}"
                        SelectionChanged="Tabs_SelectionChanged">
                <!-- 隐藏内容区（正文共用下方 WebView2） -->
                <TabControl.ContentTemplate>
                    <DataTemplate/>
                </TabControl.ContentTemplate>
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Padding" Value="12,4,8,4"/>
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TocTextBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Bd" Margin="3,4,0,4"
                                            CornerRadius="8"
                                            Background="{Binding DataContext.TabBrushLight, RelativeSource={RelativeSource TemplatedParent}}"
                                            BorderThickness="1"
                                            BorderBrush="{Binding DataContext.TabBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{Binding DataContext.TabBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                                            <Setter TargetName="Bd" Property="TextElement.Foreground"
                                                    Value="{Binding DataContext.TabFgBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.ItemContainerStyle>
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    MouseLeftButtonDown="TabHeader_MouseDown">
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="关闭" Click="TabMenu_Close"/>
                                    <MenuItem Header="关闭其他" Click="TabMenu_CloseOthers"/>
                                    <MenuItem Header="关闭右侧" Click="TabMenu_CloseRight"/>
                                    <Separator/>
                                    <MenuItem Header="复制完整路径" Click="TabMenu_CopyPath"/>
                                    <MenuItem Header="在资源管理器中显示" Click="TabMenu_Reveal"/>
                                    <MenuItem Header="重新加载" Click="TabMenu_Reload"/>
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <TextBlock Text="{Binding Title}" Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <Button Content="✕" Width="16" Height="16" FontSize="9" Padding="0"
                                    BorderThickness="0" Background="Transparent" Cursor="Hand"
                                    Foreground="{Binding TextElement.Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                    ToolTip="关闭标签（双击标签可弹出独立窗口）" Click="CloseTab_Click"/>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>

            <!-- 拖回合并停靠提示：独立窗口悬停标签区时显示 -->
            <Border x:Name="DropHint" Height="38" VerticalAlignment="Top"
                    Background="#805B8DEF" BorderThickness="2"
                    BorderBrush="#3B82F6" CornerRadius="8"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock Text="松开鼠标，合并到标签页"
                           Foreground="White" FontWeight="SemiBold" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- 底部状态栏：切换功能区标签时始终可见 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ToolbarBgBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0"
                Padding="10,4">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource StatusTextBrush}"
                       Text="将 .md 文件拖入窗口，或点击「打开」（支持命令行参数）"/>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TocColumn" Width="280"/>
                <ColumnDefinition x:Name="TocSplitterColumn" Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧目录面板（支持层级折叠） -->
            <DockPanel x:Name="TocPanel" Grid.Column="0" Background="{DynamicResource TocPanelBgBrush}">
                <Border DockPanel.Dock="Top" Padding="12,10,12,6"
                        Background="{DynamicResource TocPanelBgBrush}">
                    <TextBlock Text="目录 (TOC)" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TocTextBrush}"/>
                </Border>
                <Border DockPanel.Dock="Top" Height="1"
                        Background="{DynamicResource BorderBrush2}"/>
                <ListBox x:Name="TocListBox" BorderThickness="0"
                         Background="{DynamicResource TocPanelBgBrush}"
                         SelectionChanged="TocListBox_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Visibility" Value="{Binding Visibility}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TocTextBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource TocSelectedBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2,3">
                                <!-- 折叠/展开三角：仅父级标题显示，点击折叠子级 -->
                                <TextBlock Text="{Binding Glyph}" Width="16"
                                           FontSize="11"
                                           Foreground="{DynamicResource TocTextBrush}"
                                           Cursor="Hand"
                                           VerticalAlignment="Top"
                                           PreviewMouseLeftButtonDown="Glyph_MouseDown"/>
                                <TextBlock Text="{Binding Text}"
                                           Margin="{Binding TextIndent}"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Foreground="{DynamicResource TocTextBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- 目录与正文之间的分割线（可拖动调整宽度） -->
            <GridSplitter x:Name="TocSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource SplitterBrush}"/>

            <!-- 右侧 WebView2 预览面板 -->
            <wv2:WebView2 x:Name="WebView" Grid.Column="2"/>
        </Grid>
    </DockPanel>
</Window>
